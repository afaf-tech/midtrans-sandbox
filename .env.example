# Salin file ini ke .env lalu isi dengan key dari dashboard Midtrans
# (Dashboard -> Settings -> Access Keys). Pilih yang awalan "SB-" (sandbox).
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
PORT=3000

# Opsional: token Cloudflare Tunnel buat static domain
# (dipakai `docker compose --profile tunnel up -d`)
CLOUDFLARE_TUNNEL_TOKEN=
